{
  "global_config": {
    "loader_aliases": [
      "RDEP_ACTMZ_SCB541",
      "RDEP_ACTMZ",
      "RDEP_FRAUD",
      "RDEP_HYS_USER",
      "RDEP_SCB541",
      "RDEP_STG_FSRV",
      "RDEP_STG_FSRV_SCB541",
      "RDEP_STG_HYS",
      "RDEP_STG_OUTBOUND",
      "RFS",
      "ROLLUP",
      "FSI_SEC",
      "BLK1",
      "TEM2",
      "WFH2",
      "PHP2",
      "RAP1",
      "MERT",
      "IVR",
      "SIP1",
      "TEM1",
      "DAY1",
      "WFH1",
      "ECHAT",
      "HYD1",
      "ORL1",
      "CMS",
      "CNT1",
      "EDL",
      "CCPA_SEC",
      "MWCT_TEMP"
    ]
  },
  "dml_commit": {
    "enabled": true,
    "rule_name": "DML Commit Validation"
  },
  "ddl_no_commit": {
    "enabled": true,
    "rule_name": "DDL Must Not Contain COMMIT"
  },
  "grant_revoke_no_commit": {
    "enabled": true,
    "rule_name": "GRANT/REVOKE Commit Restriction"
  },
  "plsql_slash": {
    "enabled": true,
    "rule_name": "PL/SQL Slash Requirement"
  },
  "object_name_length": {
    "enabled": true,
    "rule_name": "Object Name Length Check",
    "max_length": 30
  },
  "backup_table_suffix": {
    "enabled": true,
    "rule_name": "Backup Table Suffix",
    "backup_suffixes": [
      "BACKUP",
      "BKP"
    ],
    "required_ending": "TBD"
  },
  "table_naming_convention": {
    "enabled": true,
    "rule_name": "Table Naming Convention"
  },
  "schema_validation": {
    "enabled": true,
    "rule_name": "Schema Validation"
  },
  "backup_grant_select": {
    "enabled": true,
    "rule_name": "Backup Table Grant Restriction",
    "allowed_user": "LOADER",
    "backup_suffixes": [
      "BACKUP",
      "BKP"
    ]
  },
  "grant_all_restriction": {
    "enabled": true,
    "rule_name": "GRANT ALL Restriction"
  },
  "grant_privilege_restriction": {
    "enabled": true,
    "rule_name": "Grant Privilege Restriction",
    "privileged_user": "LOADER",
    "allowed_privileges": [
      "SELECT"
    ]
  },
  "backup_drop_limit": {
    "enabled": true,
    "rule_name": "Backup Table Drop Limit",
    "max_drops": 400
  },
  "nologging_restriction": {
    "enabled": true,
    "rule_name": "NOLOGGING Restriction"
  },
  "semicolon_required": {
    "enabled": true,
    "rule_name": "Semicolon Termination Rule"
  },
  "column_naming": {
    "enabled": true,
    "rule_name": "Column Naming Convention"
  },
  "tablespace_restriction": {
    "enabled": true,
    "rule_name": "Tablespace Restriction",
    "forbidden_tablespaces": [
      "USERS",
      "SYSTEM",
      "SYSAUX",
      "TEMP",
      "DEFAULT"
    ]
  },
  "backup_drop_separation": {
    "enabled": true,
    "rule_name": "Backup Drop Separation"
  }
}